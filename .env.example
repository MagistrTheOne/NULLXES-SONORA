# PostgreSQL (async driver for API)
DATABASE_URL=postgresql+asyncpg://sonora:sonora@localhost:5432/sonora

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Task runner: celery | local
TASK_RUNNER=local

# Local audio storage (VST-compatible layout)
STORAGE_PATH=./storage
MAX_UPLOAD_MB=80

# DSP result versioning
ANALYZER_VERSION=SONORA_DSP_v0.1

# LLM: openai | anthropic | google
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

LOG_LEVEL=INFO
